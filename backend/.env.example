# Server & Runtime
API_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
DEMO_MODE=false

# Google Gemini API (AI Studio / Vertex AI)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.7-flash

# Google Earth Engine (GEE)
GEE_PROJECT_ID=your_gee_project_id_here
GEE_SERVICE_ACCOUNT_EMAIL=
GEE_PRIVATE_KEY_PATH=

# External Authoritative Data Providers
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
OVERPASS_API_URL=https://overpass-api.de/api/interpreter
IMD_BULLETIN_URL=https://mausam.imd.gov.in
IBTRACS_BASE_URL=https://www.ncei.noaa.gov/data/international-best-track-archive-for-climate-stewardship-ibtracs/v04r01/access/csv
