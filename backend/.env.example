# Backend Environment Variables Template
# Copy this file to .env and replace placeholder values with your real configuration.

# Application Configuration
API_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Data Paths
DATA_DIR=../data

# Gemini API Configuration (Google AI Studio)
# Free tier key from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL_NAME=gemini-2.5-flash

# Google Earth Engine (GEE) Configuration
# Non-commercial Community quota tier: https://earthengine.google.com/
GEE_PROJECT_ID=your-gee-project-id
# Optional: Service account credentials file path (leave blank for local user auth flow)
GEE_SERVICE_ACCOUNT_EMAIL=
GEE_PRIVATE_KEY_PATH=

# External API Configuration
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast
OVERPASS_API_URL=https://overpass-api.de/api/interpreter
